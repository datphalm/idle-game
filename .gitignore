# ==========================================
# IDLE RPG - GIT IGNORE CONFIGURATION
# ==========================================

# 1. File thực thi nhị phân và file nén lớn
*.exe
*.dll
*.pdb
*.zip
*.rar
dist/*.exe
dist/assets/
js/game.bundle.js

# 2. Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# 3. Dữ liệu máy chủ và tệp tạm
# server/data/*.json (Cho phép lưu giữ database.json vĩnh viễn)
scratch/
temp/
*.log

# 4. Tệp hệ điều hành và IDE
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
